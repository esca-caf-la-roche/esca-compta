{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-prod-deploy.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-access-control.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-saison-config.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-eslint.mjs"
          }
        ]
      }
    ]
  }
}
